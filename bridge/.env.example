# Bridge environment template (bridge/.env.example) — WP-2.1 / MT-2.1-02.
#
# Placeholders only: no secrets and no environment-specific values ever land in a
# repo-tracked example (parent plan Section 20.4 item 3; FR-SEC-04). Real values
# live outside Git (host secrets / shell environment / the user-level file).
#
# Layering (documented reading of parent plan Section 10.3 "environment or
# user-level config"; full key list recorded in the WP changelog):
#
#   environment variables  >  user-level config file  >  built-in defaults
#
# The user-level file (TOML) lives at:
#   Windows:  %APPDATA%\orchestrator\bridge.toml
#   POSIX:    ${XDG_CONFIG_HOME:-~/.config}/orchestrator/bridge.toml
#
# Rules: an exported-but-empty value counts as unset; the loader reads exactly
# the keys below by canonical name (foreign ORCHESTRATOR_* variables belong to
# other components); it never autoloads a cwd-relative .env and never reads the
# manifest (FR-SEC-04).
#
# Per-row metadata contract: name | group | default | validation | secret
# (docs/plan/conventions/configuration.md).

# Orchestrator API base URL (group API_) — parent plan Section 10.3.
# default http://localhost:8000/api/v1 | must be an http(s):// URL | not secret.
ORCHESTRATOR_API_BASE_URL=http://localhost:8000/api/v1

# Bridge agent token (group SECRET_) — parent plan Section 10.3 step 3, FR-SEC-04.
# environment OR user-level file only, never the manifest or a repo-tracked file.
# default unset | required once session binding lands (WP-2.2) | SECRET.
ORCHESTRATOR_AGENT_TOKEN=

# Manifest path override (group BRIDGE_) — test/passthrough hook consumed by
# WP-2.2 discovery. default unset | non-empty path when set | not secret.
ORCHESTRATOR_BRIDGE_MANIFEST_PATH=

# Log level (group LOG_) — parent plan Section 17; existing canonical name.
# default INFO | one of DEBUG, INFO, WARNING, ERROR, CRITICAL | not secret.
ORCHESTRATOR_LOG_LEVEL=INFO

# Log format (group LOG_) — MT-2.1-02/03 key; json is the Section 17 contract.
# default json | one of json, text (text is an explicit local-debug opt-in) | not secret.
ORCHESTRATOR_LOG_FORMAT=json

# Run mode (group BRIDGE_) — parent plan Section 10.2. default stdio |
# one of stdio, http, merge-executor | not secret.
# Mode-selection precedence (MT-2.1-04):
#   1. explicit invocation — console script (orchestrator-bridge-stdio/-http/
#      -executor) or --mode on `orchestrator-bridge` / `python -m orchestrator_bridge`
#   2. this key (ORCHESTRATOR_BRIDGE_MODE env > `mode` in the user config file)
#   3. default stdio
ORCHESTRATOR_BRIDGE_MODE=stdio

# Backend request timeout in seconds (group BRIDGE_) — parent plan Section 10.10.
# default 30 | number > 0 | not secret. Unit suffix mandatory (configuration.md).
ORCHESTRATOR_BRIDGE_TIMEOUT_SECONDS=30

# Backend response-size cap in MB (group BRIDGE_) — MT-2.3-01, Section 9.10.
# default 64 (clears a base64-inflated 25 MB attachment, Section 9.5) | number > 0 |
# not secret. Unit suffix mandatory (configuration.md).
ORCHESTRATOR_BRIDGE_MAX_RESPONSE_MB=64

# Retry attempt bound per call (group BRIDGE_) — MT-2.3-02, Section 10.10.
# default 3 | whole number of attempts >= 1 | not secret.
ORCHESTRATOR_BRIDGE_RETRY_MAX_ATTEMPTS=3

# First retry backoff delay in seconds (group BRIDGE_) — MT-2.3-02, Section 10.10;
# doubles each retry with jitter. default 1 | number > 0 | not secret.
ORCHESTRATOR_BRIDGE_RETRY_BASE_DELAY_SECONDS=1

# Merge Executor allowed repo paths (group MERGE_) — parent plan Section 10.2
# "config listing allowed repo paths"; required only for mode merge-executor.
# default unset/empty | non-empty paths when set | not secret. Comma-separated.
ORCHESTRATOR_MERGE_REPO_PATHS=

# HTTP/SSE run mode listen address (group BRIDGE_) — WP-2.9, Section 10.2
# "long-running local process". default 127.0.0.1 (loopback-only; a wider bind
# is an explicit opt-in per Section 12.4) | bare host or IP, no scheme | not
# secret. Never an environment-specific value in this template.
ORCHESTRATOR_BRIDGE_HTTP_HOST=127.0.0.1

# HTTP/SSE listen port (group BRIDGE_) — WP-2.9. default 8765 (avoids the
# backend's 8000) | whole number 0-65535, 0 = ephemeral (tests) | not secret.
ORCHESTRATOR_BRIDGE_HTTP_PORT=8765

# HTTP/SSE maximum concurrent connections (group BRIDGE_) — WP-2.9 / MT-2.9-03.
# default 16 | whole number >= 1 | not secret. Excess connections are refused
# with CONCURRENCY_LIMIT_REACHED and a close-idle-sessions hint.
ORCHESTRATOR_BRIDGE_HTTP_MAX_CONNECTIONS=16

# HTTP/SSE idle-connection timeout in seconds (group BRIDGE_) — WP-2.9 /
# MT-2.9-03. default 900 | number > 0 | not secret. A connection with no
# request and no open SSE stream for this long is closed (session end
# best-effort, Section 10.10).
ORCHESTRATOR_BRIDGE_HTTP_IDLE_TIMEOUT_SECONDS=900

# Session image capability (group BRIDGE_) — WP-2.5, Section 10.4 step 2 /
# MT-2.5-01. The operator's startup declaration of what this MCP session's
# client can render: `vision` delivers images as MCP image blocks;
# `text_only` delivers OCR text + description and rejects image_base64
# unless explicitly forced. default unset (= unknown = text-safe) | one of
# vision, text_only | not secret. Never claim vision the client lacks
# (ADR-006): the bridge never infers this value — set it only from a
# verified client run (see bridge/capability_table/README.md).
ORCHESTRATOR_BRIDGE_SESSION_CAPABILITY=

# Correlation id (runtime scope input; parent plan Section 17, headers.md) —
# installed into the log scope at startup; a well-formed value is honored, an
# absent/empty/malformed one is replaced by a generated id. Not a persistent
# setting: ORCHESTRATOR_* naming kept for one vocabulary (configuration.md).
ORCHESTRATOR_CORRELATION_ID=
