# ============================================================================
# AI Agent Task Orchestrator — Compose environment template (parent plan 9.10)
#
# Copy to infra/compose/.env and edit; that file is git-ignored and is the only
# place real values live (Section 16.2). This committed template contains
# placeholders only — never real credentials (plan 20.4 item 3).
#
# Every variable below documents: purpose | default | validation note.
# Naming follows docs/plan/conventions/configuration.md (WP-0.5, MT-0.5-01):
# every name is ORCHESTRATOR_<SETTING> — one name, no aliases.
#
# REQUIRED IN PROD (Section 16.2): the backend's startup validation refuses to
# boot in prod when these are missing or weak —
#   ORCHESTRATOR_DATABASE_PASSWORD, ORCHESTRATOR_DATABASE_URL,
#   ORCHESTRATOR_SECRET_KEY, ORCHESTRATOR_ALLOWED_HOSTS,
#   ORCHESTRATOR_DEBUG=false, ORCHESTRATOR_BIND_ADDR (set to this host's address),
#   ORCHESTRATOR_CLOUDFLARE_TUNNEL_TOKEN (when remote access is enabled, WP-5.1).
# "Weak" = a listed placeholder value, a short/low-entropy secret, or a
# default left unchanged from this file. Enforced by the backend in WP-1.1;
# this template fixes the contract now.
# ============================================================================

# --- Compose: images (Section 16.1 image basis; env-only per NFR-06) --------
# ORCHESTRATOR_IMAGE_<SERVICE>: default images, pinned to major/minor tags;
# prod must keep them pinned (never :latest). Validation: tags must exist at
# pull time.
ORCHESTRATOR_IMAGE_POSTGRES=postgres:16-alpine
ORCHESTRATOR_IMAGE_REDIS=redis:7.4-alpine
ORCHESTRATOR_IMAGE_BACKEND=orchestrator-backend:stub   # WP-1.1 replaces with the real image
ORCHESTRATOR_IMAGE_WEB=orchestrator-web:stub           # WP-4.1 replaces with the real image
ORCHESTRATOR_IMAGE_CLOUDFLARED=cloudflare/cloudflared:2026.10.0
ORCHESTRATOR_IMAGE_MAILHOG=mailhog/mailhog:v1.0.1

# --- Compose: published ports (Section 16.1: LAN interface only) -----------
# ORCHESTRATOR_BIND_ADDR — the interface backend/web ports bind to.
# Default (template): replace with YOUR host's LAN interface IP, e.g.
#   192.168.1.42 (ipconfig /ifconfig) — this is the plan's "LAN interface by
#   default" posture. When unset, compose falls back to 127.0.0.1 (local only).
#   Never use 0.0.0.0 on an internet-facing VPS: the tunnel (WP-5.1) is the
#   only public edge. Validation: must be a valid IP assigned to this host.
ORCHESTRATOR_BIND_ADDR=192.168.1.100
ORCHESTRATOR_PORT_BACKEND=8000                  # host port for the API; default 8000
ORCHESTRATOR_PORT_WEB=3000                      # host port for the UI; default 3000

# --- 9.10 group: database and cache URLs (consumed by M0 stack) ------------
# Canonical names; the Postgres container receives its image-mandated
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB from these (configuration.md
# rule 7 — one name in the template, mapped at the container boundary).
ORCHESTRATOR_DATABASE_USER=orchestrator         # db role; default "orchestrator"; prod: non-placeholder value
ORCHESTRATOR_DATABASE_PASSWORD=change-me        # REQUIRED-PROD; secret; weak-placeholder rule above; postgres refuses empty
ORCHESTRATOR_DATABASE_NAME=orchestrator         # database name; default "orchestrator"
# Backend-side DB URL. Leave empty in Compose deployments: the stack derives
# `postgresql://<ORCHESTRATOR_DATABASE_USER>:<ORCHESTRATOR_DATABASE_PASSWORD>@postgres:5432/<ORCHESTRATOR_DATABASE_NAME>`
# from the ORCHESTRATOR_DATABASE_* values above (single source for credentials).
# Set it only to point at an external database. REQUIRED-PROD; validation:
# scheme postgresql:// and, in Compose, host `postgres`.
ORCHESTRATOR_DATABASE_URL=
ORCHESTRATOR_CACHE_URL=redis://redis:6379/0                 # cache/pub-sub URL; default db 0; validation: scheme redis://
ORCHESTRATOR_CACHE_BROKER_URL=redis://redis:6379/0          # Celery broker URL; default db 0; validation: scheme redis://
ORCHESTRATOR_CACHE_APPENDONLY=true                          # Redis persistence (Section 16.1); true → redis appendonly yes, false disables it

# --- 9.10 group: secret keys (consumed by M0 stack) ------------------------
# REQUIRED-PROD. Dev placeholder only; startup validation in prod refuses this
# exact value and any weak/missing secret (Section 16.2) — generate with
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
ORCHESTRATOR_SECRET_KEY=change-me

# Reserved: bridge environment fallback for the agent token (Section 10.3);
# consumed by the bridge once it lands, not read by the M0 compose services.
# ORCHESTRATOR_AGENT_TOKEN=

# --- 9.10 group: allowed hosts and CORS/CSRF origins -----------------------
# ORCHESTRATOR_DEBUG: default "false" (prod posture); set "true" only for local dev.
# Validation: prod boot refused while true (Section 16.2).
ORCHESTRATOR_DEBUG=false
# REQUIRED-PROD: comma-separated hostnames serving the API; validation: prod
# boot refused when left at the localhost placeholder.
ORCHESTRATOR_ALLOWED_HOSTS=localhost
# Reserved: consumed by the backend from WP-1.1 (wired into its settings by
# WP-1.1; not read by the M0 compose services themselves). Defaults target the
# two known origins only (Section 15.4); mobile uses token auth (no cookies).
ORCHESTRATOR_CORS_ORIGINS=http://localhost:3000
ORCHESTRATOR_CSRF_ORIGINS=http://localhost:3000

# --- 9.10 group: storage backend (Section 16.3) ----------------------------
ORCHESTRATOR_STORAGE_BACKEND=local              # "local" named volume (default) | "s3" (reserved, WP-6.2)
ORCHESTRATOR_STORAGE_MEDIA_ROOT=/media          # mount point of the backend_media volume (consumed by M0 stack)
# Reserved placeholders for the s3-compatible backend (WP-1.1 settings /
# WP-6.2 wiring); empty until ORCHESTRATOR_STORAGE_BACKEND=s3:
# ORCHESTRATOR_STORAGE_S3_ENDPOINT=
# ORCHESTRATOR_STORAGE_S3_BUCKET=
# ORCHESTRATOR_STORAGE_S3_ACCESS_KEY_ID=
# ORCHESTRATOR_STORAGE_S3_SECRET_ACCESS_KEY=

# --- 9.10 group: token lifetimes (RESERVED — not consumed by M0) -----------
# No default exists in the parent plan yet: values are fixed by WP-1.2 when
# token models land (flagged here rather than invented — plan 20.1 principle 5).
# ORCHESTRATOR_TOKEN_LIFETIME_AGENT_HOURS=
# ORCHESTRATOR_TOKEN_LIFETIME_DEVICE_DAYS=

# --- 9.10 group: rate limits (RESERVED — not consumed by M0) ---------------
# Defaults fixed with the rate-limiting implementation (WP-1.2 / WP-6.1).
# ORCHESTRATOR_RATE_LIMIT_API_PER_MINUTE=

# --- 9.10 group: OCR engine (RESERVED — consumer arrives WP-1.11+) --------
# Default per Section 6.6: tesseract (pluggable interface, replaceable later).
# ORCHESTRATOR_OCR_ENGINE=tesseract

# --- 9.10 group: description provider (RESERVED; OQ-07 deferred to M1) -----
# Recommended default recorded in Section 22: disabled; enabling a configured
# vision model is an owner decision (OQ-07) deferred to M1.
ORCHESTRATOR_DESCRIPTION_PROVIDER=disabled

# --- 9.10 group: FCM credentials (RESERVED — WP-5.4) -----------------------
# ORCHESTRATOR_FCM_PROJECT_ID=
# ORCHESTRATOR_FCM_CREDENTIALS_JSON=

# --- 9.10 group: Cloudflare tunnel token (consumed by M0 compose service) ---
# Empty is valid for the M0 quick-tunnel placeholder; REQUIRED-PROD once the
# named tunnel is provisioned (WP-5.1). Validation: non-empty for tunnel runs;
# rotate via the Cloudflare dashboard (Section 15.4).
ORCHESTRATOR_CLOUDFLARE_TUNNEL_TOKEN=

# --- 9.10 group: feature flags (RESERVED — backend consumer from WP-1.1) ---
# Comma-separated list of ORCHESTRATOR_FEATURE_<NAME> flags; default: none enabled.
ORCHESTRATOR_FEATURE_FLAGS=
