# --- Python (backend, bridge) ---
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
# Coverage artifacts (WP-1.15 coverage gate; MT-1.15-05): the data file the
# runner writes and the JSON report scripts/coverage_gate.py consumes.
.coverage
.coverage.*
coverage-report.json

# --- Node.js (web) ---
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
.eslintcache

# --- Flutter (mobile) ---
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies

# --- Environment files: real values are never committed (parent plan Section 12.4).
# The committed template is named `.env.example` and stays trackable; every other
# `.env*` variant (and a bare `.env`) can never be staged.
.env
.env.*
!.env.example

# --- Logs, OS, IDE ---
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Backups (WP-6.2; Section 12.4): database dumps and the media mirror
# contain hashed tokens and audit rows — never staged. The default host
# directory the worker's /backups mount resolves to (see .env.example);
# ORCHESTRATOR_BACKUP_HOST_DIR can point elsewhere, but this default must
# stay untracked even when the directory exists locally.
infra/compose/backup-data/
