# Upstream orchestrator API that the Next.js server proxies `/api/v1/*`
# requests to (see next.config.ts). Naming and semantics follow
# docs/plan/conventions/configuration.md — `ORCHESTRATOR_API_BASE_URL`
# (group `API_`, documented default below). The value MUST include the
# `/api/v1` base path. When unset, the documented default is used.
ORCHESTRATOR_API_BASE_URL=http://localhost:8000/api/v1
